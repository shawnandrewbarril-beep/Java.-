package warehouseinventoryscanner;


import java.util.Scanner;

public class WarehouseInventoryScanner {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        // Warehouse inventory: -1 means damaged shelf
        int[][] warehouse = {
            {10, 5, 8},
            {4, -1, 2},
            {1, 3, 0}
        };

        int choice;

        // Menu runs until the user chooses to exit
        do {
            System.out.println("\n=== WAREHOUSE INVENTORY SCANNER ===");
            System.out.println("1. Display Inventory");
            System.out.println("2. Calculate Total Items");
            System.out.println("3. Find Critical Shelf");
            System.out.println("4. Restock Shelf");
            System.out.println("5. Exit");
            System.out.print("Enter your choice: ");
            choice = input.nextInt();

            switch (choice) {
                case 1:
                    System.out.println("\nWarehouse Inventory:");

                    for (int i = 0; i < warehouse.length; i++) {
                        for (int j = 0; j < warehouse[i].length; j++) {
                            if (warehouse[i][j] == -1) {
                                System.out.print("[DAMAGED] ");
                                continue;
                            }
                            System.out.print(warehouse[i][j] + " ");
                        }
                        System.out.println();
                    }
                    break;
                case 2:
                    int total = 0;

                    for (int i = 0; i < warehouse.length; i++) {
                        for (int j = 0; j < warehouse[i].length; j++) {
                            if (warehouse[i][j] == -1) {
                                continue;
                            }
                            total += warehouse[i][j];
                        }
                    }

                    System.out.println("Total Items: " + total);
                    break;

                case 3:
                    boolean found = false;

                    // Nested loops find the first critical shelf
                    for (int i = 0; i < warehouse.length; i++) {
                        for (int j = 0; j < warehouse[i].length; j++) {
                            if (warehouse[i][j] == -1) {
                                continue;
                            }

                            if (warehouse[i][j] <= 2) {
                                System.out.println(
                                    "Critical shelf found at Row "
                                    + (i + 1) + ", Column " + (j + 1)
                                    + " with " + warehouse[i][j] + " items."
                                );
                                found = true;
                                break;
                            }
                        }

                        if (found) {
                            break;
                        }
                    }

                    if (!found) {
                        System.out.println("No critical shelf found.");
                    }
                    break;

                case 4:
                    System.out.print("Enter row (1-3): ");
                    int row = input.nextInt();

                    System.out.print("Enter column (1-3): ");
                    int col = input.nextInt();

                    if (row < 1 || row > warehouse.length
                            || col < 1 || col > warehouse[0].length) {
                        System.out.println("Invalid shelf location!");
                        break;
                    }

                    if (warehouse[row - 1][col - 1] == -1) {
                        System.out.println("Cannot restock a damaged shelf!");
                        break;
                    }

                    int quantity;

                    // Validate restocking quantity using a while loop
                    while (true) {
                        System.out.print("Enter quantity to add: ");
                        quantity = input.nextInt();

                        if (quantity > 0) {
                            break;
                        }

                        System.out.println(
                            "Invalid quantity! Enter a number greater than zero."
                        );
                    }

                    warehouse[row - 1][col - 1] += quantity;
                    System.out.println("Restocking successful!");
                    System.out.println(
                        "New shelf count: " + warehouse[row - 1][col - 1]
                    );
                    break;

                case 5:
                    System.out.println("Exiting Warehouse Inventory Scanner...");
                    input.close();
                    return;

                default:
                    System.out.println("Invalid choice! Please try again.");
            }

        } while (choice != 5);

        input.close();
    }
}
