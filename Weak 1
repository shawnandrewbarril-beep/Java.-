public class OverflowSharingInvestigation {
    public static void main(String[] args) {

        // PART 1: Primitive Overflow Behavior
        System.out.println("=== PRIMITIVE OVERFLOW ===");

        byte number = 127;
        System.out.println("Before increment: " + number);

        number++;
        System.out.println("After increment: " + number);
        // A byte has a maximum value of 127.
        // Incrementing 127 wraps around to -128.

        // PART 2: String Comparison
        System.out.println("\n=== STRING COMPARISON ===");

        String str1 = new String("Hello");
        String str2 = new String("Hello");
        String str3 = "Hello";

        // Compare str1 and str2
        System.out.println("str1 == str2: " + (str1 == str2));
        // False because new String() creates two different objects.

        System.out.println("str1.equals(str2): " + str1.equals(str2));
        // True because both strings contain the same text.

        // Compare str1 and str3
        System.out.println("str1 == str3: " + (str1 == str3));
        // False because str1 refers to a new object, while str3
        // refers to the string literal in the string pool.

        System.out.println("str1.equals(str3): " + str1.equals(str3));
        // True because both strings contain the text "Hello".

        // Compare str2 and str3
        System.out.println("str2 == str3: " + (str2 == str3));
        // False because str2 refers to a new object and str3
        // refers to the string literal in the string pool.

        System.out.println("str2.equals(str3): " + str2.equals(str3));
        // True because both strings contain the same text.

        // PART 3: Array Reference Sharing
        System.out.println("\n=== ARRAY REFERENCE SHARING ===");

        int[] originalArray = {10, 20, 30};
        int[] sharedArray = originalArray;

        System.out.println("Before modification:");
        System.out.println("Original array first element: " + originalArray[0]);
        System.out.println("Shared array first element: " + sharedArray[0]);

        sharedArray[0] = 99;

        System.out.println("\nAfter modification:");
        System.out.println("Original array first element: " + originalArray[0]);
        System.out.println("Shared array first element: " + sharedArray[0]);

        // Both variables refer to the same array object.
        // Changing the array through sharedArray is visible
        // when accessing it through originalArray.
    }
}

