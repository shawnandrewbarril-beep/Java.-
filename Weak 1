package unitcastingconverter;
import java.util.Scanner;

public class UnitCastingConverter {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        // Read a double value representing centimeters
        System.out.print("Enter centimeters: ");
        double centimeters = input.nextDouble();

        // Explicit casting: convert centimeters to whole meters
        int meters = (int) (centimeters / 100);

        // Calculate the remaining centimeters
        double remainingCentimeters = centimeters - (meters * 100);

        System.out.println("Whole meters: " + meters);
        System.out.println("Remaining centimeters: " + remainingCentimeters);

        // Implicit widening: int to double
        int number = 25;
        double widenedNumber = number; // No cast needed because double can store int values

        System.out.println("Implicit widening (int to double): " + widenedNumber);

        // Explicit narrowing: double to int
        double decimalNumber = 12.75;
        int narrowedNumber = (int) decimalNumber;
        // The decimal part (.75) is lost during narrowing

        System.out.println("Explicit narrowing (double to int): " + narrowedNumber);

        input.close();
    }
}
