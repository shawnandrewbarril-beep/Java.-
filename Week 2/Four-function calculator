
import java.util.Scanner;

public class BasicArithmetic {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        // Read two integers from the user
        System.out.print("Enter the first integer: ");
        int num1 = input.nextInt();

        System.out.print("Enter the second integer: ");
        int num2 = input.nextInt();

        // Apply basic arithmetic operators
        System.out.println("\n--- Arithmetic Results ---");
        System.out.println("Addition (+): " + (num1 + num2));
        System.out.println("Subtraction (-): " + (num1 - num2));
        System.out.println("Multiplication (*): " + (num1 * num2));

        // Division and remainder behave differently with negative operands:
        // Java integer division truncates toward zero, and the remainder
        // has the same sign as the dividend (the first number).
        if (num2 != 0) {
            System.out.println("Division (/): " + (num1 / num2));
            System.out.println("Modulo (%): " + (num1 % num2));
        } else {
            System.out.println("Division (/): Undefined (cannot divide by zero)");
            System.out.println("Modulo (%): Undefined (cannot divide by zero)");
        }

        input.close();
    }
}
